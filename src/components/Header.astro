---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE, withBase } from "../consts";
---

<header>
  <nav>
    <h2><HeaderLink href={withBase("/")}>{SITE_TITLE}</HeaderLink></h2>
    <div class="internal-links">
      <HeaderLink href={withBase("/")}>首页</HeaderLink>
      <HeaderLink href={withBase("/about")}>关于</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 1em 0;
    font-size: 1em;
  }
  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
  }
  nav h2 {
    justify-self: start;
  }
  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.5em;
    justify-self: center;
  }
  nav a {
    padding: 0.5em 1em;
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
    transition: color 0.2s ease-in-out;
  }
  nav a:hover {
    color: rgb(var(--accent));
    background-color: rgba(var(--accent), 0.1);
  }
  nav a.active {
    color: rgb(var(--accent));
  }
</style>
