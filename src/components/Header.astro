---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, withBase } from '../consts';
---

<header>
	<nav>
		<h2><a href={withBase('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={withBase('/')}>首页</HeaderLink>
			<HeaderLink href={withBase('/about')}>关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1.5em;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	nav a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
</style>
